# Uniquement hors Coolify (docker compose sur un serveur) : copiez ce fichier en .env et changez les valeurs.
# Dans Coolify, ces variables sont générées automatiquement.
SERVICE_USER_POSTGRES=gazflow
SERVICE_PASSWORD_POSTGRES=changez-moi-mot-de-passe-long
SERVICE_PASSWORD_64_AUTH=changez-moi-secret-tres-long-et-aleatoire
